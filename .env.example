# Smart Document Hub — copy to .env (root, for Docker) or backend/.env (local dev).
# Everything is optional: with no values the app runs fully locally with an in-memory DB.

APP_ENV=development
DEBUG=true

# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://localhost

# MongoDB. Use "mock://" to force the in-memory database.
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=smart_document_hub
MONGODB_FALLBACK_TO_MOCK=true

# Gemini — optional. Without a key, tags/deadlines use spaCy rules and answers are extractive.
# Free key: https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Redis — optional (search cache + shared rate limits)
REDIS_URL=redis://localhost:6379

# google | gemini | none
TRANSLATOR=google

GRAPH_SIMILARITY_THRESHOLD=0.5
MAX_UPLOAD_SIZE_MB=50

# Seed demo@dochub.dev / demo12345 with sample documents on first start
SEED_DEMO=true
